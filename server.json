    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@asthanaji/openapi-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}